# --- LLM (free tier: https://console.groq.com). Leave blank to run the offline heuristic engine.
GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Optional: serve the fine-tuned small model (OpenAI-compatible server, e.g. llama.cpp / Ollama / vLLM)
FT_BASE_URL=
FT_MODEL=cadral-router-1b

# --- Auth / app
SECRET_KEY=change-me-long-random-string
ADMIN_EMAIL=admin@cadral.test
ADMIN_PASSWORD=ChangeMe-Admin1
AGENT_EMAIL=agent@cadral.test
AGENT_PASSWORD=ChangeMe-Agent1
DB_PATH=data/cadral.db
AUTO_REFUND_LIMIT_GBP=100

# --- Slack alerts (incoming webhook)
SLACK_WEBHOOK_URL=

# --- Email out (SMTP) + email in (IMAP poll). All optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@cadral.test
MANAGER_EMAIL=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# --- Telegram (optional second channel, long-polling)
TELEGRAM_BOT_TOKEN=

# --- Daily report time (UTC hour)
REPORT_HOUR_UTC=7
